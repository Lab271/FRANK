# FRANK Platform - Environment Variables
#
# Copy this file to .env and customize as needed for local development.
#
# Usage:
#   cp .env.example .env
#   docker compose -f docker-compose.local.yml up -d
#
# Copyright (c) 2025 Schuberg Philis B.V.
# SPDX-License-Identifier: Apache-2.0

# Logging
LOG_LEVEL=info

# Hot-reload for development (set to true for automatic code reloading)
RELOAD=false
TEMPLATE_AUTO_RELOAD=false

# Service Ports
MOCK_COGNITO_PORT=8100
MANAGEMENT_API_PORT=8001
WEB_GUI_PORT=3000

# Authentication (Mock Cognito)
JWT_SECRET=mock-cognito-secret-key
JWT_ALGORITHM=RS256
USER_POOL_ID=eu-west-1_MOCKPOOL
CLIENT_ID=mock-client-id-123456
REGION=eu-west-1
VALIDATION_STRATEGY=local_only

# Session Management (Web GUI)
FRANK_SESSION_SECRET=development-secret-key-change-in-production-min-32-chars
FRANK_SESSION_COOKIE_NAME=frank_session
FRANK_SESSION_MAX_AGE=3600
