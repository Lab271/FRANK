# Accept platform arguments from buildx
ARG TARGETPLATFORM
ARG BUILDPLATFORM

FROM python:3.13-slim AS base

# Platform-specific optimizations
RUN case "${TARGETPLATFORM}" in \
    "linux/amd64") \
        echo "Building for AMD64 (AWS Fargate compatible)" \
        ;; \
    "linux/arm64") \
        echo "Building for ARM64 (M1/M2 Mac and AWS Graviton compatible)" \
        ;; \
    *) \
        echo "Building for platform: ${TARGETPLATFORM}" \
        ;; \
    esac

# ===================================
# Builder Stage
# ===================================
FROM base AS builder

WORKDIR /app

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn==0.24.0 \
    pyjwt==2.8.0 \
    requests==2.31.0 \
    python-multipart==0.0.6 \
    cryptography==41.0.7


# ===================================
# Production Stage
# ===================================

FROM builder AS production

ARG BUILD_CONTEXT=tests/spikes/010_cognito
ARG PACKAGE_CONTEXT=.


# Set working directory
WORKDIR /app

COPY ${BUILD_CONTEXT}/README.md .
COPY ${PACKAGE_CONTEXT}/setup.py .
COPY ${PACKAGE_CONTEXT}/src/ ./src/

# RUN pip install -e .
RUN pip install --no-cache- .

COPY ${BUILD_CONTEXT}/simple_api.py .


# Expose port 8000 for internal communication
EXPOSE 8000

# Set environment variables
ENV PORT=8000
ENV MOCK_COGNITO_URL=http://mock-cognito:8100

# Run the application
CMD ["python", "simple_api.py"]