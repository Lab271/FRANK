FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn==0.24.0 \
    pyjwt==2.8.0 \
    requests==2.31.0 \
    python-multipart==0.0.6 \
    cryptography==41.0.7

# Copy FRANK core module for enum imports
# Note: In docker build context, we need to copy from the build context
# For now, we'll install from the local package or copy the enum module directly

# Create frank module structure and copy enum
RUN mkdir -p /app/frank/core
COPY simple_api.py .

# Create a simple enum module for docker (since ../../../src/frank is outside context)
RUN echo 'from enum import Enum\n\
class AccessTier(str, Enum):\n\
    PUBLIC = "public"\n\
    OBSERVER = "observer"\n\
    CONTRIBUTOR = "contributor"\n\
    PARTNER = "partner"\n\
    CORE_MEMBER = "core_member"' > /app/frank/core/enum.py

# Create __init__.py files
RUN touch /app/frank/__init__.py && touch /app/frank/core/__init__.py

# Expose port 8080 for internal communication
EXPOSE 8080

# Set environment variables
ENV PORT=8080
ENV MOCK_COGNITO_URL=http://mock-cognito:8080

# Run the application
CMD ["uvicorn", "simple_api:app", "--host", "0.0.0.0", "--port", "8000"]