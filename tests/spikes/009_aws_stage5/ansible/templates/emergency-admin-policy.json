{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EmergencyFullAccess",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        },
        "NumericLessThan": {
          "aws:MultiFactorAuthAge": "300"
        },
        "StringEquals": {
          "aws:PrincipalTag/EmergencyAccess": "true"
        }
      }
    }
  ]
}