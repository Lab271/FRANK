# Accept platform arguments from buildx
ARG TARGETPLATFORM
ARG BUILDPLATFORM

FROM python:3.13-slim AS base

# Platform-specific optimizations
RUN case "${TARGETPLATFORM}" in \
    "linux/amd64") \
        echo "Building for AMD64 (AWS Fargate compatible)" \
        ;; \
    "linux/arm64") \
        echo "Building for ARM64 (M1/M2 Mac and AWS Graviton compatible)" \
        ;; \
    *) \
        echo "Building for platform: ${TARGETPLATFORM}" \
        ;; \
    esac

# ===================================
# Builder Stage
# ===================================
FROM base AS builder

WORKDIR /app

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies
RUN pip install --no-cache-dir --user \
    fastapi==0.118.3 \
    uvicorn==0.37.0 \
    PyJWT==2.10.1 \
    python-multipart==0.0.20 \
    cryptography==46.0.2


# ===================================
# Production Stage
# ===================================

FROM base AS production

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r frankuser && useradd -r -g frankuser frankuser

# Copy Python dependencies from builder stage
COPY --from=builder /root/.local /home/frankuser/.local

ARG BUILD_CONTEXT=tests/spikes/014_cognito
ARG PACKAGE_CONTEXT=.


# Set working directory
WORKDIR /app

COPY ${BUILD_CONTEXT}/README.md .
COPY ${PACKAGE_CONTEXT}/pyproject.toml .
# Load frank package and install
COPY ${PACKAGE_CONTEXT}/src/ ./src/.
RUN pip install --no-cache-dir .

COPY ${BUILD_CONTEXT}/mock_cognito.py .

# Change ownership to frankuser
RUN chown -R frankuser:frankuser /app

# Switch to non-root user
USER frankuser

# Expose port 8100 for internal communication
EXPOSE 8100

# Set environment variables
ENV PATH=/home/frankuser/.local/bin:$PATH
ENV PORT=8100

# Run the application
CMD ["python", "mock_cognito.py"]