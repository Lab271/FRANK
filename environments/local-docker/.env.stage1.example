# FRANK Local Docker Environment - Stage 1 (SQLite)
# Copy to .env and customize

# Environment identifier (DO NOT CHANGE)
FRANK_ENVIRONMENT=local-docker

# Stage
FRANK_STAGE=1

# Application
PORT=8000
LOG_LEVEL=info
RELOAD=true  # Hot-reload for development

# Database (SQLite - mounted volume)
DATABASE_URL=sqlite:///./data/frank.db
