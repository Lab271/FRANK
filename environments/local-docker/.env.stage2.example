# FRANK Local Docker Environment - Stage 2 (PostgreSQL/DynamoDB)
# Copy to .env and customize

# Environment identifier (DO NOT CHANGE)
FRANK_ENVIRONMENT=local-docker

# Stage
FRANK_STAGE=2

# Application
PORT=8000
LOG_LEVEL=info
RELOAD=true

# Database (PostgreSQL - docker service)
DATABASE_URL=postgresql://frank:frank_dev@postgres:5432/frank_management

# DynamoDB (LocalStack - docker service)
DYNAMODB_ENDPOINT=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-1
DYNAMODB_TABLE=frank-submissions

# Authentication (optional for Stage 2)
FRANK_AUTH_MODE=none
