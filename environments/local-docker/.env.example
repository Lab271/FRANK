# FRANK Local Docker Environment Configuration
# Copy to .env and customize
#
# This file is used by docker-compose.yml for all stages

# Environment identification
FRANK_ENVIRONMENT=local-docker
FRANK_STAGE=3

# Service Ports
MANAGEMENT_API_PORT=8001
WEB_GUI_PORT=3000
ADMIN_API_PORT=8002
MOCK_COGNITO_PORT=8100
POSTGRES_PORT=5432
LOCALSTACK_PORT=4566
DYNAMODB_ADMIN_PORT=8101

# PostgreSQL Configuration
POSTGRES_DB=frank_management
POSTGRES_USER=frank
POSTGRES_PASSWORD=frank_dev

# Application Settings
LOG_LEVEL=info
RELOAD=false
TEMPLATE_AUTO_RELOAD=false

# LocalStack/DynamoDB
LOCALSTACK_DEBUG=0
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DYNAMODB_TABLE=frank-submissions
DYNAMODB_ENDPOINT=http://localstack:4566

# Mock Cognito Settings
JWT_SECRET=mock-cognito-secret-key
JWT_ALGORITHM=HS256
USER_POOL_ID=eu-west-1_MOCKPOOL
CLIENT_ID=mock-client-id-123456
REGION=eu-west-1

# Authentication
FRANK_AUTH_MODE=mock
COGNITO_URL=http://mock-cognito:8100
VALIDATION_STRATEGY=local_only

# Web GUI Session
FRANK_SESSION_SECRET=development-secret-key-change-in-production-min-32-chars

# Database URL (used by management API)
# Stage 1: DATABASE_URL=sqlite:///./data/frank.db
# Stage 2-3: DATABASE_URL=postgresql://frank:frank_dev@postgres:5432/frank_management
DATABASE_URL=postgresql://frank:frank_dev@postgres:5432/frank_management
