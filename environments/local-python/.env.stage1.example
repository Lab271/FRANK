# FRANK Local Python Environment - Stage 1 (SQLite)
# Copy to .env and customize

# Environment identifier (DO NOT CHANGE)
FRANK_ENVIRONMENT=local-python

# Stage
FRANK_STAGE=1

# Application
PORT=8000
LOG_LEVEL=info
RELOAD=true  # Hot-reload for development

# Database (SQLite)
DATABASE_URL=sqlite:///./frank.db

# No authentication in Stage 1 (optional)
# FRANK_AUTH_MODE=none
