# FRANK AWS Production Environment - Stage 3
# Copy to .env.stage3 and customize

# Environment identifier
FRANK_ENVIRONMENT=aws-prod
FRANK_STAGE=3

# AWS Configuration
AWS_REGION=eu-central-1
AWS_PROFILE=frank-prod
AWS_ACCOUNT_ID=<prod-account-id>

# Application
PORT=8000
LOG_LEVEL=info

# Database (RDS PostgreSQL - Multi-AZ)
DATABASE_URL=postgresql://<username>:<password>@<rds-endpoint>:5432/frank_management

# DynamoDB (Point-in-time recovery enabled)
DYNAMODB_ENDPOINT=  # Leave empty for AWS DynamoDB
AWS_ACCESS_KEY_ID=  # Use IAM role
AWS_SECRET_ACCESS_KEY=  # Use IAM role
DYNAMODB_TABLE=frank-prod-submissions

# Cognito Authentication
FRANK_AUTH_MODE=cognito
COGNITO_USER_POOL_ID=<prod-pool-id>
COGNITO_CLIENT_ID=<prod-client-id>
COGNITO_REGION=eu-central-1
VALIDATION_STRATEGY=aws_cognito

# Infrastructure
ECS_CLUSTER_NAME=frank-prod
RDS_INSTANCE_NAME=frank-prod-db
DYNAMODB_TABLE_PREFIX=frank-prod

# Scaling (production capacity)
ECS_MIN_TASKS=2
ECS_MAX_TASKS=10
ECS_DESIRED_TASKS=3

# High Availability
RDS_MULTI_AZ=true
RDS_BACKUP_RETENTION=30
DYNAMODB_PITR=true  # Point-in-time recovery
