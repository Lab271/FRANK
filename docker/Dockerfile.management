# FRANK Platform - Management API Container
#
# Provides organisation and user management CRUD operations.
#
# Copyright (c) 2025 Schuberg Philis B.V.
# SPDX-License-Identifier: Apache-2.0

# Accept platform arguments from buildx
ARG TARGETPLATFORM
ARG BUILDPLATFORM

FROM python:3.13-slim AS base

# Platform-specific optimizations
RUN case "${TARGETPLATFORM}" in \
    "linux/amd64") \
        echo "Building for AMD64 (AWS Fargate compatible)" \
        ;; \
    "linux/arm64") \
        echo "Building for ARM64 (M1/M2 Mac and AWS Graviton compatible)" \
        ;; \
    *) \
        echo "Building for platform: ${TARGETPLATFORM}" \
        ;; \
    esac

# ===================================
# Builder Stage
# ===================================
FROM base AS builder

WORKDIR /app

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir --user \
    fastapi==0.120.0 \
    uvicorn==0.38.0 \
    PyJWT==2.10.1 \
    httpx==0.28.1 \
    python-multipart==0.0.20 \
    cryptography==45.0.0 \
    pydantic==2.12.0

# ===================================
# Production Stage
# ===================================
FROM base AS production

# Create non-root user
RUN groupadd -r frankuser && useradd -r -g frankuser frankuser

# Copy Python dependencies from builder stage
COPY --from=builder /root/.local /home/frankuser/.local

# Set working directory
WORKDIR /app

# Copy project files
COPY pyproject.toml .
COPY README.md .
COPY src/ ./src/

# Install the frank package
RUN pip install --no-cache-dir .

# Create data directory for SQLite
RUN mkdir -p /data && chown -R frankuser:frankuser /data

# Change ownership to frankuser
RUN chown -R frankuser:frankuser /app

# Switch to non-root user
USER frankuser

# Set environment variables
ENV PATH=/home/frankuser/.local/bin:$PATH
ENV PORT=8001
ENV FRANK_DB_PATH=/data/frank.db
ENV FRANK_AUTH_MODE=mock
ENV COGNITO_URL=http://localhost:8100

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Expose port
EXPOSE ${PORT}

# Run the Management API server
CMD ["python", "-m", "frank.management.server"]
