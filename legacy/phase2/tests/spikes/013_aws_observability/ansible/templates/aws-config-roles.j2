# AWS CLI Configuration for FRANK Security Roles
# Generated by Ansible for Account: {{ account_id }}
# Add these sections to your ~/.aws/config file

# Infrastructure Creation Role (2 hours, MFA required)
[profile frank-infra]
role_arn = arn:aws:iam::{{ account_id }}:role/frank-infra-creator
source_profile = {{ source_profile }}
external_id = {{ external_id }}
mfa_serial = arn:aws:iam::{{ account_id }}:mfa/your-username
duration_seconds = 7200
region = eu-central-1

# Infrastructure Destruction Role (30 minutes, MFA required)
[profile frank-destroy]
role_arn = arn:aws:iam::{{ account_id }}:role/frank-infra-destroyer
source_profile = {{ source_profile }}
external_id = {{ external_id }}
mfa_serial = arn:aws:iam::{{ account_id }}:mfa/your-username
duration_seconds = 1800
region = eu-central-1

# Application Deployment Role (4 hours, no MFA for CI/CD)
[profile frank-deploy]
role_arn = arn:aws:iam::{{ account_id }}:role/frank-app-deployer
source_profile = {{ source_profile }}
external_id = {{ external_id }}
duration_seconds = 14400
region = eu-central-1

# Data Reading Role (8 hours, no MFA)
[profile frank-data]
role_arn = arn:aws:iam::{{ account_id }}:role/frank-data-reader
source_profile = {{ source_profile }}
external_id = {{ external_id }}
duration_seconds = 28800
region = eu-central-1

# Emergency Admin Role (15 minutes, MFA required)
[profile frank-emergency]
role_arn = arn:aws:iam::{{ account_id }}:role/frank-emergency-admin
source_profile = {{ source_profile }}
external_id = {{ external_id }}
mfa_serial = arn:aws:iam::{{ account_id }}:mfa/your-username
duration_seconds = 900
region = eu-central-1