# FRANK AWS Pre-Production Environment - Stage 3
# Copy to .env.stage3 and customize

# Environment identifier
FRANK_ENVIRONMENT=aws-preprod
FRANK_STAGE=3

# AWS Configuration
AWS_REGION=eu-central-1
AWS_PROFILE=frank-preprod
AWS_ACCOUNT_ID=<preprod-account-id>

# Application
PORT=8000
LOG_LEVEL=info

# Database (RDS PostgreSQL)
DATABASE_URL=postgresql://<username>:<password>@<rds-endpoint>:5432/frank_management

# DynamoDB
DYNAMODB_ENDPOINT=  # Leave empty for AWS DynamoDB
AWS_ACCESS_KEY_ID=  # Use IAM role
AWS_SECRET_ACCESS_KEY=  # Use IAM role
DYNAMODB_TABLE=frank-preprod-submissions

# Cognito Authentication
FRANK_AUTH_MODE=cognito
COGNITO_USER_POOL_ID=<preprod-pool-id>
COGNITO_CLIENT_ID=<preprod-client-id>
COGNITO_REGION=eu-central-1
VALIDATION_STRATEGY=aws_cognito

# Infrastructure
ECS_CLUSTER_NAME=frank-preprod
RDS_INSTANCE_NAME=frank-preprod-db
DYNAMODB_TABLE_PREFIX=frank-preprod

# Scaling (reduced from production)
ECS_MIN_TASKS=1
ECS_MAX_TASKS=5
ECS_DESIRED_TASKS=1
