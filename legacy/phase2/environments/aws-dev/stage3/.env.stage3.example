# FRANK AWS Development Environment - Stage 3
# Copy to .env.stage3 and customize

# Environment identifier
FRANK_ENVIRONMENT=aws-dev
FRANK_STAGE=3

# AWS Configuration
AWS_REGION=eu-central-1
AWS_PROFILE=frank-dev
AWS_ACCOUNT_ID=<dev-account-id>

# Application
PORT=8000
LOG_LEVEL=info

# Database (RDS PostgreSQL)
DATABASE_URL=postgresql://<username>:<password>@<rds-endpoint>:5432/frank_management

# DynamoDB
DYNAMODB_ENDPOINT=  # Leave empty for AWS DynamoDB
AWS_ACCESS_KEY_ID=  # Use IAM role
AWS_SECRET_ACCESS_KEY=  # Use IAM role
DYNAMODB_TABLE=frank-dev-submissions

# Cognito Authentication
FRANK_AUTH_MODE=cognito
COGNITO_USER_POOL_ID=<dev-pool-id>
COGNITO_CLIENT_ID=<dev-client-id>
COGNITO_REGION=eu-central-1
VALIDATION_STRATEGY=aws_cognito

# Infrastructure
ECS_CLUSTER_NAME=frank-dev
RDS_INSTANCE_NAME=frank-dev-db
DYNAMODB_TABLE_PREFIX=frank-dev

# Scaling
ECS_MIN_TASKS=1
ECS_MAX_TASKS=3
ECS_DESIRED_TASKS=1
