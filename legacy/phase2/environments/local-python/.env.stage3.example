# FRANK Local Python Environment - Stage 3 (Full Stack)
# Copy to .env and customize

# Environment identifier (DO NOT CHANGE)
FRANK_ENVIRONMENT=local-python

# Stage
FRANK_STAGE=3

# Application
PORT=8000
LOG_LEVEL=info
RELOAD=true

# Database (PostgreSQL - requires running instance)
DATABASE_URL=postgresql://frank:frank_dev@localhost:5432/frank_management

# DynamoDB (LocalStack or AWS)
DYNAMODB_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-1
DYNAMODB_TABLE=frank-submissions

# Authentication (Mock Cognito - requires running instance)
FRANK_AUTH_MODE=mock
COGNITO_URL=http://localhost:8100
JWT_SECRET=mock-cognito-secret-key
JWT_ALGORITHM=HS256
USER_POOL_ID=eu-west-1_MOCKPOOL
REGION=eu-west-1
VALIDATION_STRATEGY=local_only
