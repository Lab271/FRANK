# FRANK Local Python Environment - Stage 2 (PostgreSQL/DynamoDB)
# Copy to .env and customize

# Environment identifier (DO NOT CHANGE)
FRANK_ENVIRONMENT=local-python

# Stage
FRANK_STAGE=2

# Application
PORT=8000
LOG_LEVEL=info
RELOAD=true

# Database (PostgreSQL - requires running instance)
DATABASE_URL=postgresql://frank:frank_dev@localhost:5432/frank_management

# DynamoDB (LocalStack)
DYNAMODB_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-1
DYNAMODB_TABLE=frank-submissions

# Authentication (optional for Stage 2)
FRANK_AUTH_MODE=none
