	"item": [
		{
			"name": "Submit Threat Intelligence",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "X-Api-Key",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"submission\": {\n    \"submitter\": {\n      \"organisation_id\": \"org-postman-test\",\n      \"tier\": \"partner\",\n      \"sector\": \"finance\"\n    },\n    \"sighting\": {\n      \"sighting_id\": \"test-sighting-postman-001\",\n      \"timestamp\": \"2025-09-05T12:00:00Z\",\n      \"confidence\": 85,\n      \"observables\": {\n        \"network\": [\n          {\n            \"type\": \"ipv4\",\n            \"value\": \"192.168.1.100\",\n            \"role\": \"c2_server\"\n          },\n          {\n            \"type\": \"domain\",\n            \"value\": \"malicious.example.com\",\n            \"role\": \"phishing_domain\"\n          }\n        ]\n      }\n    }\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/v1/submission",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"submission"
					]
				},
				"description": "Submit threat intelligence data to FRANK platform"
			},
			"response": []
		},
