#cloud-config
# FRANK VM: podman runs the FRANK image; data lives on the attached
# volume at /srv/frank (plain files: data/ with sightings/, iocs.db and
# registry.db; participants/participants.db). Nightly copies of
# participants.db, the one database that cannot be rebuilt, go to
# /srv/frank/backup. With a bucket (store), the sightings and the audit log
# live in Object Storage instead (FRANK_STORE, ADR-019); the WAL stays on
# the volume.
package_update: true
packages:
  - podman
  - caddy
  - sqlite3
  - curl

write_files:
  - path: /etc/frank/frank.env
    permissions: "0644"
    content: |
      FRANK_IMAGE=${image}
      FRANK_RETENTION_DAYS=${retention_days}
%{ if store != "" ~}
  - path: /etc/frank/store.env
    permissions: "0600"
    content: |
      FRANK_STORE=${store}
      AWS_ACCESS_KEY_ID=${store_key}
      AWS_SECRET_ACCESS_KEY=${store_secret}
%{ endif ~}
%{ if sso_issuer != "" ~}
  # SSO (ADR-020): the settings, and the client secret as a file, mounted
  # into the container; FRANK never reads it from the environment.
  - path: /etc/frank/sso.env
    permissions: "0644"
    content: |
      FRANK_SSO_ISSUER=${sso_issuer}
      FRANK_SSO_CLIENT_ID=${sso_client_id}
      FRANK_SSO_CLIENT_SECRET_FILE=/run/secrets/frank-sso-client-secret
      FRANK_SSO_REDIRECT_URL=https://${domain}/v1/sso/callback
      FRANK_SSO_ORGANISATION=${sso_org}
  - path: /etc/frank/sso-client-secret
    permissions: "0600"
    content: ${jsonencode(sso_secret)}
%{ endif ~}
  - path: /etc/systemd/system/frank.service
    permissions: "0644"
    content: |
      [Unit]
      Description=FRANK threat-sighting sharing
      Wants=network-online.target
      After=network-online.target srv-frank.mount
      Requires=srv-frank.mount

      [Service]
      EnvironmentFile=/etc/frank/frank.env
      ExecStartPre=-/usr/bin/podman rm -f frank
      ExecStartPre=/usr/bin/podman pull --authfile /etc/frank/auth.json $${FRANK_IMAGE}
      # Logs (ADR-024, #308): JSON lines with `target`, so `frank`,
      # `frank::access` and `mvl_manifest` can be shipped as separate
      # streams. passthrough: the container's stdout is this unit's, so
      # journald stores each line whole (up to LineMax, journald.conf.d)
      # and once. The journald driver cuts lines into 8 KiB partial
      # entries, which breaks the manifest's packages line (tens of KiB),
      # and an attached `podman run` would log every line a second time.
      ExecStart=/usr/bin/podman run --name frank --rm \
        --log-driver passthrough \
        -e RUST_LOG=frank=info,mvl_manifest=info \
        -e FRANK_LOG_FORMAT=json \
        -p 127.0.0.1:8080:8080 \
        -v /srv/frank/data:/data:Z \
        -v /srv/frank/participants:/participants:Z \
        -v /srv/frank/tokens:/etc/frank/tokens:ro,Z \
        -e FRANK_RETENTION_DAYS=$${FRANK_RETENTION_DAYS} \
%{ if store != "" ~}
        --env-file /etc/frank/store.env \
%{ endif ~}
%{ if sso_issuer != "" ~}
        --env-file /etc/frank/sso.env \
        -v /etc/frank/sso-client-secret:/run/secrets/frank-sso-client-secret:ro,Z \
%{ endif ~}
        $${FRANK_IMAGE}
      ExecStop=/usr/bin/podman stop -t 30 frank
      # `journalctl -t frank`: without it the lines carry `podman`.
      SyslogIdentifier=frank
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target
  - path: /usr/local/bin/frank-backup
    permissions: "0755"
    content: |
      #!/bin/sh
      # A copy of participants.db (organisations, users, tokens; #159),
      # which cannot be rebuilt from the sightings as iocs.db and
      # registry.db can. sqlite3 .backup takes SQLite's locks, which
      # db-core honours, so FRANK keeps running. Two weeks are kept.
      set -eu
      d=/srv/frank/backup/$(date -u +%F)
      mkdir -p "$d"
      if [ -f /srv/frank/participants/participants.db ]; then
        sqlite3 /srv/frank/participants/participants.db ".backup '$d/participants.db'"
      fi
      chmod -R go-rwx /srv/frank/backup
      find /srv/frank/backup -mindepth 1 -maxdepth 1 -type d -mtime +14 -exec rm -rf {} +
  - path: /etc/systemd/system/frank-backup.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Back up FRANK's participants
      Requires=srv-frank.mount
      After=srv-frank.mount

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/frank-backup
  - path: /etc/systemd/system/frank-backup.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Nightly backup of FRANK's participants

      [Timer]
      OnCalendar=*-*-* 03:15:00
      Persistent=true

      [Install]
      WantedBy=timers.target
  # GeoIP (monthly) and the IoC lists (daily) into /srv/frank/data (#276):
  # scripts/fetch-geoip.sh and scripts/fetch-lists.sh, as `make geoip` and
  # `make lists` run them. As FRANK's user, so the files are its own; a failed
  # download keeps the previous files, and FRANK picks up new ones itself.
  - path: /usr/local/bin/frank-fetch-geoip
    permissions: "0755"
    content: |
      ${indent(6, chomp(fetch_geoip))}
  - path: /usr/local/bin/frank-fetch-lists
    permissions: "0755"
    content: |
      ${indent(6, chomp(fetch_lists))}
%{ if abuse_key != "" ~}
  - path: /etc/frank/lists.env
    permissions: "0600"
    content: |
      ABUSE_KEY=${abuse_key}
%{ endif ~}
%{ for job, spec in { geoip = ["DB-IP Lite GeoIP databases", "*-*-03 04:00:00"], lists = ["IoC lists", "*-*-* 04:30:00"] } ~}
  - path: /etc/systemd/system/frank-${job}.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Fetch FRANK's ${spec[0]}
      Wants=network-online.target
      After=network-online.target srv-frank.mount
      Requires=srv-frank.mount

      [Service]
      Type=oneshot
      User=65532
      Group=65532
%{ if job == "lists" ~}
      EnvironmentFile=-/etc/frank/lists.env
%{ endif ~}
      ExecStart=/usr/local/bin/frank-fetch-${job} /srv/frank/data
  - path: /etc/systemd/system/frank-${job}.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Fetch FRANK's ${spec[0]}

      [Timer]
      OnCalendar=${spec[1]}
      RandomizedDelaySec=30m
      Persistent=true

      [Install]
      WantedBy=timers.target
%{ endfor ~}
  - path: /etc/systemd/journald.conf.d/frank.conf
    permissions: "0644"
    content: |
      # ADR-024, #308: FRANK's lines (frank, frank::access) and Caddy's
      # access log name users and keep query strings (#287), so the
      # journal keeps them 30 days, across reboots. This bounds every
      # unit's journal on this VM, which holds nothing else that needs
      # longer. A log store the lines are shipped to sets its own.
      # LineMax: a longer line is cut in two; the runtime manifest's
      # packages line is tens of KiB (#315).
      [Journal]
      Storage=persistent
      MaxRetentionSec=30day
      LineMax=1M
  - path: /etc/caddy/Caddyfile
    permissions: "0644"
    content: |
      ${domain} {
        encode zstd gzip
        # The web stream (ADR-024, #307): JSON to stdout, so journald
        # (kept 30 days, #308). FRANK's X-Request-Id is on each line;
        # Authorization and cookies are redacted while log_credentials
        # stays unset.
        log {
          output stdout
          format json
        }
        # HSTS (#244): a public certificate, so a year; FRANK sets the
        # other security headers itself.
        header Strict-Transport-Security "max-age=31536000"
        reverse_proxy 127.0.0.1:8080
      }

runcmd:
  # The data volume: formatted once, mounted on /srv/frank.
  - |
    for i in $(seq 1 60); do [ -e "${data_disk}" ] && break; sleep 5; done
    blkid "${data_disk}" || mkfs.ext4 -L frank-data "${data_disk}"
    mkdir -p /srv/frank
    grep -q frank-data /etc/fstab || echo "LABEL=frank-data /srv/frank ext4 defaults,nofail 0 2" >> /etc/fstab
    systemctl daemon-reload
    mount -a
    mkdir -p /srv/frank/data /srv/frank/participants && touch /srv/frank/tokens
    chown -R 65532:65532 /srv/frank/data /srv/frank/participants /srv/frank/tokens
    if [ -f /etc/frank/sso-client-secret ]; then chown 65532:65532 /etc/frank/sso-client-secret; fi
    chmod 600 /srv/frank/tokens
  - |
    umask 077
    if [ -n "${registry_token}" ]; then
      printf '%s' '${registry_token}' | podman login --authfile /etc/frank/auth.json -u '${registry_user}' --password-stdin '${registry}'
    else
      echo '{}' > /etc/frank/auth.json
    fi
  - systemctl daemon-reload
  # The 30-day journal (journald.conf.d/frank.conf) before anything logs.
  - systemctl restart systemd-journald
  - systemctl enable --now frank.service
  - systemctl enable --now frank-backup.timer
  - systemctl enable --now frank-geoip.timer frank-lists.timer
  # The first fetch now rather than at the first timer.
  - systemctl start --no-block frank-geoip.service frank-lists.service
  - systemctl restart caddy
