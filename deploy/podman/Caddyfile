# HTTPS in front of FRANK in podman (`make up`): https://frank.local
# (FRANK_HOST), and https://localhost. The certificate comes from Caddy's
# own local CA (`tls internal`), kept in the caddy-data volume; `make
# trust` adds that CA's root to the macOS keychain once, so browsers
# accept it. On STACKIT the same Caddy gets a public certificate instead.
# http://frank.local (FRANK_HTTP_ADDR, port 80) only redirects there.
{
	# The redirect below is ours: Caddy's own would point at port 443 of
	# the container, not at the host port (FRANK_HTTPS_PORT).
	auto_https disable_redirects
	# The root goes into the host's keychain (`make trust`), not the
	# container's trust store.
	skip_install_trust
	# TCP only is published, so no HTTP/3 (QUIC) to advertise.
	servers {
		protocols h1 h2
	}
}

(frank) {
	tls internal
	encode zstd gzip
	reverse_proxy frank:8080
}

# HSTS (#244) for FRANK_HOST only: on localhost it would hold for every
# other local server too. One day, not a year: after `make untrust` a
# browser refuses frank.local, with no way past it, until it expires.
{$FRANK_HOST:frank.local} {
	import frank
	header Strict-Transport-Security "max-age=86400"
}

localhost {
	import frank
}

http://{$FRANK_HOST:frank.local}, http://localhost {
	# 307: temporary, so a browser does not keep it when the port changes,
	# and a POST stays a POST.
	redir https://{host}:{$FRANK_HTTPS_PORT:8443}{uri} 307
}
