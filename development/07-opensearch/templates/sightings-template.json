{
  "index_patterns": ["frank-sightings-*"],
  "template": {
    "settings": {
      "number_of_shards": 2,
      "number_of_replicas": 1,
      "index.mapping.total_fields.limit": 2000,
      "index.max_result_window": 50000,
      "analysis": {
        "analyzer": {
          "threat_analyzer": {
            "type": "custom",
            "tokenizer": "keyword",
            "filter": ["lowercase", "threat_normalizer"]
          },
          "ip_analyzer": {
            "type": "custom",
            "tokenizer": "keyword",
            "filter": ["lowercase"]
          }
        },
        "filter": {
          "threat_normalizer": {
            "type": "pattern_replace",
            "pattern": "[\\[\\]\\(\\)\\{\\}\\\"\\']",
            "replacement": ""
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "tenant_id": {
          "type": "keyword",
          "index": true
        },
        "tenant_hash": {
          "type": "keyword",
          "index": true
        },
        "sighting_id": {
          "type": "keyword",
          "index": true
        },
        "sighting_hash": {
          "type": "keyword",
          "index": true
        },
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "created_at": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "updated_at": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "confidence": {
          "type": "integer",
          "index": true
        },
        "severity": {
          "type": "keyword",
          "index": true
        },
        "category": {
          "type": "keyword",
          "index": true
        },
        "tags": {
          "type": "keyword",
          "index": true
        },
        "source": {
          "properties": {
            "name": {
              "type": "text",
              "analyzer": "standard",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "type": {
              "type": "keyword",
              "index": true
            },
            "reliability": {
              "type": "keyword",
              "index": true
            }
          }
        },
        "indicators": {
          "type": "nested",
          "properties": {
            "type": {
              "type": "keyword",
              "index": true
            },
            "value": {
              "type": "text",
              "analyzer": "threat_analyzer",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "value_hash": {
              "type": "keyword",
              "index": true
            },
            "pattern": {
              "type": "text",
              "analyzer": "standard"
            },
            "confidence": {
              "type": "integer",
              "index": true
            }
          }
        },
        "network": {
          "properties": {
            "src_ip": {
              "type": "ip"
            },
            "dst_ip": {
              "type": "ip"
            },
            "src_port": {
              "type": "integer"
            },
            "dst_port": {
              "type": "integer"
            },
            "protocol": {
              "type": "keyword",
              "index": true
            },
            "domain": {
              "type": "text",
              "analyzer": "threat_analyzer",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "url": {
              "type": "text",
              "analyzer": "standard",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          }
        },
        "file": {
          "properties": {
            "name": {
              "type": "text",
              "analyzer": "standard",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "path": {
              "type": "text",
              "analyzer": "standard",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "size": {
              "type": "long"
            },
            "type": {
              "type": "keyword",
              "index": true
            },
            "hash": {
              "properties": {
                "md5": {
                  "type": "keyword",
                  "index": true
                },
                "sha1": {
                  "type": "keyword",
                  "index": true
                },
                "sha256": {
                  "type": "keyword",
                  "index": true
                }
              }
            }
          }
        },
        "process": {
          "properties": {
            "name": {
              "type": "text",
              "analyzer": "standard",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "pid": {
              "type": "integer"
            },
            "ppid": {
              "type": "integer"
            },
            "command_line": {
              "type": "text",
              "analyzer": "standard"
            },
            "executable": {
              "type": "text",
              "analyzer": "standard",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          }
        },
        "geo": {
          "properties": {
            "country": {
              "type": "keyword",
              "index": true
            },
            "region": {
              "type": "keyword",
              "index": true
            },
            "city": {
              "type": "keyword",
              "index": true
            },
            "location": {
              "type": "geo_point"
            }
          }
        },
        "metadata": {
          "properties": {
            "labels": {
              "type": "keyword",
              "index": true
            },
            "mitre_technique": {
              "type": "keyword",
              "index": true
            },
            "kill_chain_phase": {
              "type": "keyword",
              "index": true
            },
            "external_references": {
              "type": "nested",
              "properties": {
                "source_name": {
                  "type": "keyword"
                },
                "url": {
                  "type": "keyword"
                },
                "external_id": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "description": {
          "type": "text",
          "analyzer": "standard"
        },
        "raw_data": {
          "type": "object",
          "enabled": false
        }
      }
    }
  },
  "priority": 200,
  "composed_of": [],
  "_meta": {
    "description": "Index template for FRANK threat sightings data",
    "version": "1.0.0"
  }
}
