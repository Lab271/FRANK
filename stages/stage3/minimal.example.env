
# ================================
# .env.minimal.example
# Minimal environment configuration for FRANK Stage 3
# ================================

# AWS Credentials (REQUIRED)
# Get these from AWS Console -> IAM -> Users -> Security Credentials
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_DEFAULT_REGION=eu-west-1

# DynamoDB Configuration
# This will be set automatically after running 'make deploy-aws'
DYNAMODB_TABLE=frank-table
DYNAMODB_AUDIT_TABLE=frank-audit-table
FRANK_ENVIRONMENT=aws

# Application Settings
FRANK_DEBUG=true
PORT=8000

# Optional: Custom table name (if you want to use a different name)
# DYNAMODB_TABLE_NAME=my-custom-frank-table