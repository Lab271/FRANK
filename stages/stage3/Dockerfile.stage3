# ================================
# Dockerfile.stage3 - Application Container
# ================================
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for MySQL
RUN apt-get update && apt-get install -y \
    gcc \
    pkg-config \
    curl \
    && rm -rf /var/lib/apt/lists/*


# Copy the current stage3 files
COPY src/ /app/src/           
COPY stages/stage3/ /app/stage3/

# Install Python dependencies
RUN pip install --upgrade pip

WORKDIR /app/stage3

# This is a bit weird, but need to copy this so we can get the package
COPY ./stages/stage3/setup.py ../src
# Install the src package in development mode
RUN pip install -e ../src/

# Create logs directory
RUN mkdir -p /app/logs

# Expose port
EXPOSE 8000

WORKDIR /app/stage3

# Default command
CMD ["python", "frank_stage3.py"]